<?xml version="1.0" encoding="UTF-8"?>
<!-- Reverse-proxies requests under /crm-app/lpg-tool/ to the local Flask
     LPG bulk-search tool (Gas/lpg_web/app.py, must be running on 127.0.0.1:9196).
     This runs server-side via IIS ARR, so it works for remote visitors too —
     unlike an iframe pointed straight at 127.0.0.1, which only ever works for
     someone browsing from this same machine (found 2026-07-21). -->
<configuration>
  <system.webServer>
    <rewrite>
      <rules>
        <rule name="LPG Tool Reverse Proxy" stopProcessing="true">
          <match url="^lpg-tool/?(.*)" />
          <action type="Rewrite" url="http://127.0.0.1:9196/{R:1}" />
        </rule>
      </rules>
    </rewrite>
  </system.webServer>
</configuration>
